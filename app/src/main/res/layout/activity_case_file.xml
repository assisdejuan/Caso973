<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_case_file"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kraft"
    android:fillViewport="true"
    tools:context=".CaseFileActivity">

    <!-- Único filho direto do NestedScrollView -->
    <LinearLayout
        android:id="@+id/column_case_file"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_margin"
        android:paddingBottom="@dimen/gap_l">

        <!-- Identificação -->
        <LinearLayout
            android:id="@+id/block_ident"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            android:background="@color/folder"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/page_margin"
            android:paddingTop="@dimen/gap_l"
            android:paddingBottom="@dimen/gap_m">

            <TextView
                android:id="@+id/tv_file_ident"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/file_ident"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/ink_soft" />

            <TextView
                android:id="@+id/tv_file_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_xs"
                android:fontFamily="serif"
                android:text="@string/file_title"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                android:textColor="@color/ink"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_file_class"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_s"
                android:background="@drawable/bg_stamp_box"
                android:fontFamily="monospace"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:rotation="-2"
                android:text="@string/file_class"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/stamp_red"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 01 Resumo -->
        <LinearLayout android:id="@+id/sheet_summary" style="@style/Sheet">
            <TextView android:id="@+id/tv_h_summary" style="@style/SheetHeading" android:text="@string/h_summary" />
            <TextView android:id="@+id/tv_summary" style="@style/TypedText" android:text="@string/summary_body" />
        </LinearLayout>

        <!-- 02 Suspeitos -->
        <LinearLayout android:id="@+id/sheet_suspects" style="@style/Sheet">
            <TextView android:id="@+id/tv_h_suspects" style="@style/SheetHeading" android:text="@string/h_suspects" />

            <LinearLayout
                android:id="@+id/row_suspect_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_suspect_a_letter"
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:background="@drawable/bg_avatar"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="@string/suspect_a_letter"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/sheet"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_suspect_a_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="@string/suspect_a_name"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="@color/ink"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_suspect_a_body"
                        style="@style/TypedText"
                        android:layout_marginTop="2dp"
                        android:text="@string/suspect_a_body" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_suspect_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_suspect_b_letter"
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:background="@drawable/bg_avatar"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="@string/suspect_b_letter"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/sheet"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_suspect_b_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="@string/suspect_b_name"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="@color/ink"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_suspect_b_body"
                        style="@style/TypedText"
                        android:layout_marginTop="2dp"
                        android:text="@string/suspect_b_body" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_suspect_c"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_suspect_c_letter"
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:background="@drawable/bg_avatar"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="@string/suspect_c_letter"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/sheet"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_suspect_c_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="@string/suspect_c_name"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="@color/ink"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_suspect_c_body"
                        style="@style/TypedText"
                        android:layout_marginTop="2dp"
                        android:text="@string/suspect_c_body" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_suspect_d"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_suspect_d_letter"
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:background="@drawable/bg_avatar"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="@string/suspect_d_letter"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/sheet"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_suspect_d_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="@string/suspect_d_name"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="@color/ink"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_suspect_d_body"
                        style="@style/TypedText"
                        android:layout_marginTop="2dp"
                        android:text="@string/suspect_d_body" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- 03 Evidências textuais -->
        <LinearLayout android:id="@+id/sheet_text_evidence" style="@style/Sheet">
            <TextView android:id="@+id/tv_h_text_evidence" style="@style/SheetHeading" android:text="@string/h_text_evidence" />

            <TextView android:id="@+id/tv_operator_head" style="@style/SubHeading" android:text="@string/ev_operator_head" />
            <TextView
                android:id="@+id/tv_operator_body"
                style="@style/TypedText"
                android:background="@drawable/bg_sticky_note"
                android:padding="@dimen/gap_m"
                android:rotation="-1"
                android:text="@string/ev_operator_body"
                android:textStyle="italic" />

            <TextView android:id="@+id/tv_gate_head" style="@style/SubHeading" android:text="@string/ev_gate_head" />
            <TextView android:id="@+id/tv_gate_body" style="@style/TypedText" android:fontFamily="monospace" android:text="@string/ev_gate_body" />

            <TextView android:id="@+id/tv_harbor_head" style="@style/SubHeading" android:text="@string/ev_harbor_head" />
            <TextView android:id="@+id/tv_harbor_body" style="@style/TypedText" android:text="@string/ev_harbor_body" />

            <TextView android:id="@+id/tv_morse_head" style="@style/SubHeading" android:text="@string/ev_morse_head" />
            <TextView
                android:id="@+id/tv_morse_table"
                style="@style/TypedText"
                android:background="@color/kraft"
                android:fontFamily="monospace"
                android:padding="@dimen/gap_m"
                android:text="@string/ev_morse_table"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 04 Evidência visual: texto e mapa separados por Guideline vertical -->
        <LinearLayout android:id="@+id/sheet_visual_evidence" style="@style/Sheet">
            <TextView android:id="@+id/tv_h_visual_evidence" style="@style/SheetHeading" android:text="@string/h_visual_evidence" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_map_evidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_s">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide_map"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.44" />

                <TextView
                    android:id="@+id/tv_map_head"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/ev_map_head"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/ink_soft"
                    app:layout_constraintEnd_toStartOf="@id/guide_map"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_map_body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_xs"
                    android:layout_marginEnd="@dimen/gap_s"
                    android:fontFamily="serif"
                    android:text="@string/ev_map_body"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/ink"
                    app:layout_constraintEnd_toStartOf="@id/guide_map"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_map_head" />

                <ImageView
                    android:id="@+id/iv_signal_map"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_polaroid"
                    android:contentDescription="@string/cd_map"
                    android:padding="6dp"
                    android:rotation="1.5"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_signal_map"
                    app:layout_constraintDimensionRatio="H,4:3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/guide_map"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <!-- 05 Evidência sonora -->
        <LinearLayout android:id="@+id/sheet_audio_evidence" style="@style/Sheet">
            <TextView android:id="@+id/tv_h_audio_evidence" style="@style/SheetHeading" android:text="@string/h_audio_evidence" />
            <TextView android:id="@+id/tv_audio_body" style="@style/TypedText" android:text="@string/ev_audio_body" />

            <!-- Painel do gravador -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/panel_recorder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:background="@drawable/bg_recorder"
                android:padding="@dimen/gap_m">

                <TextView
                    android:id="@+id/tv_tape_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/recorder_label"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="@color/folder"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_player_state"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_s"
                    android:layout_marginEnd="@dimen/gap_s"
                    android:drawablePadding="@dimen/gap_s"
                    android:fontFamily="monospace"
                    android:text="@string/state_waiting"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textColor="@color/recorder_text"
                    app:layout_constraintEnd_toStartOf="@id/tv_tape_time"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_tape_label" />

                <TextView
                    android:id="@+id/tv_tape_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/recorder_led"
                    app:layout_constraintBaseline_toBaselineOf="@id/tv_player_state"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="00:00 / 00:32" />

                <!-- Chain horizontal com os três controles principais -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_play"
                    style="@style/RecorderButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginTop="@dimen/gap_m"
                    android:layout_marginEnd="@dimen/gap_xs"
                    android:contentDescription="@string/cd_play"
                    android:text="@string/btn_play"
                    app:icon="@drawable/ic_play"
                    app:layout_constraintEnd_toStartOf="@id/btn_pause"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_player_state" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pause"
                    style="@style/RecorderButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginHorizontal="@dimen/gap_xs"
                    android:contentDescription="@string/cd_pause"
                    android:text="@string/btn_pause"
                    app:icon="@drawable/ic_pause"
                    app:layout_constraintEnd_toStartOf="@id/btn_restart"
                    app:layout_constraintStart_toEndOf="@id/btn_play"
                    app:layout_constraintTop_toTopOf="@id/btn_play" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_restart"
                    style="@style/RecorderButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginStart="@dimen/gap_xs"
                    android:contentDescription="@string/cd_restart"
                    android:text="@string/btn_restart"
                    app:icon="@drawable/ic_restart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btn_pause"
                    app:layout_constraintTop_toTopOf="@id/btn_play" />

                <!-- Recuar e avançar dividem o espaço por peso -->
                <LinearLayout
                    android:id="@+id/row_seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_s"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_play">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_rewind"
                        style="@style/RecorderSeekButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/btn_height"
                        android:layout_marginEnd="@dimen/gap_xs"
                        android:layout_weight="1"
                        android:contentDescription="@string/cd_rewind"
                        android:text="@string/btn_rewind" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_forward"
                        style="@style/RecorderSeekButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/btn_height"
                        android:layout_marginStart="@dimen/gap_xs"
                        android:layout_weight="1"
                        android:contentDescription="@string/cd_forward"
                        android:text="@string/btn_forward" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <!-- 06 Relatório final -->
        <LinearLayout android:id="@+id/sheet_solution" style="@style/Sheet">
            <TextView android:id="@+id/tv_h_solution" style="@style/SheetHeading" android:text="@string/h_solution" />
            <TextView android:id="@+id/tv_solution_prompt" style="@style/TypedText" android:text="@string/solution_prompt" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_culprit"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:hint="@string/hint_culprit">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_culprit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="40"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_reasoning"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_s"
                android:hint="@string/hint_reasoning"
                app:counterEnabled="true"
                app:counterMaxLength="400">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_reasoning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="400"
                    android:minLines="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_verify"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="@dimen/gap_s"
                android:text="@string/btn_verify"
                android:textStyle="bold"
                app:cornerRadius="4dp" />

            <TextView
                android:id="@+id/tv_verdict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:fontFamily="serif"
                android:freezesText="true"
                android:padding="@dimen/gap_m"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:visibility="gone"
                tools:background="@drawable/bg_verdict_rejected"
                tools:text="@string/verdict_rejected"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- 07 Créditos -->
        <LinearLayout android:id="@+id/sheet_credits" style="@style/Sheet">
            <TextView android:id="@+id/tv_h_credits" style="@style/SheetHeading" android:text="@string/h_credits" />
            <TextView
                android:id="@+id/tv_credits"
                style="@style/TypedText"
                android:text="@string/credits_body"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/ink_soft" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/gap_l"
            android:text="@string/btn_back"
            android:textColor="@color/ink"
            app:cornerRadius="4dp"
            app:strokeColor="@color/ink" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
