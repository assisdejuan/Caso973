<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- "Sombra" deslocada, como uma folha sobre a pasta -->
    <item android:left="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/folder_dark" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:bottom="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/sheet" />
            <corners android:radius="2dp" />
            <stroke android:width="1dp" android:color="@color/sheet_rule" />
        </shape>
    </item>
</layer-list>
